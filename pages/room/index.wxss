.room-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.hero,
.panel {
  padding: 30rpx 28rpx;
}

.title,
.field-label {
  font-size: 24rpx;
  color: #ffd166;
}

.subtitle,
.hint-text {
  margin-top: 16rpx;
  color: rgba(246, 247, 251, 0.78);
  font-size: 26rpx;
  line-height: 1.7;
}

.status-chip,
.mini-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  font-size: 22rpx;
}

.status-chip.connected {
  color: #d9f99d;
}

.status-chip.disconnected {
  color: #fecaca;
}

.input-field {
  width: 100%;
  margin-top: 12rpx;
  min-height: 96rpx;
  padding: 24rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #14213d;
  font-size: 30rpx;
  line-height: 1.4;
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.section-head,
.player-row,
.player-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.room-id {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.player-row {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
}

.player-name {
  font-size: 30rpx;
  font-weight: 600;
}

.player-order {
  font-size: 24rpx;
  color: rgba(246, 247, 251, 0.7);
}
