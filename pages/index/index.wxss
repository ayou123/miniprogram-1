.home-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.hero,
.player-panel,
.library,
.manuals,
.data-panel {
  padding: 34rpx 30rpx;
}

.lang-row,
.library-head,
.game-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-badge {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 209, 102, 0.16);
  color: #ffd166;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.lang-switch {
  margin: 0;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #f6f7fb;
  font-size: 24rpx;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.15;
}

.hero-subtitle,
.player-hint,
.library-hint,
.game-desc,
.data-hint {
  margin-top: 16rpx;
  color: rgba(246, 247, 251, 0.78);
  font-size: 28rpx;
  line-height: 1.7;
}

.section-title {
  font-size: 24rpx;
  color: #ffd166;
  letter-spacing: 2rpx;
}

.name-input {
  width: 100%;
  height: 92rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #14213d;
  font-size: 30rpx;
}

.quick-row,
.manual-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.quick-chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  font-size: 24rpx;
}

.mini-btn {
  width: auto;
  min-width: 180rpx;
  padding: 0 28rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 24rpx;
}

.game-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 28rpx;
}

.game-card.is-ready {
  background: linear-gradient(135deg, rgba(255, 209, 102, 0.16) 0%, rgba(255, 183, 3, 0.08) 100%);
  border: 1rpx solid rgba(255, 209, 102, 0.24);
}

.game-card.is-soon {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.game-info {
  flex: 1;
}

.game-title {
  font-size: 36rpx;
  font-weight: 700;
}

.game-status {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(11, 16, 32, 0.22);
  color: #ffd166;
  font-size: 22rpx;
}

.game-action,
.manual-btn {
  margin-top: 22rpx;
}

.manual-btn {
  flex: 1;
  min-width: 280rpx;
}

.stat-total {
  display: flex;
  align-items: end;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.06);
}

.stat-label,
.distribution-title {
  font-size: 24rpx;
  color: #ffd166;
}

.stat-value {
  font-size: 56rpx;
  font-weight: 800;
}

.distribution-block {
  margin-top: 24rpx;
}

.distribution-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.data-chip {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  font-size: 24rpx;
}
